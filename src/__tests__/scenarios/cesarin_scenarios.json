{
  "scenarios": [
    {
      "id": "policy-shipping-01",
      "scenario_type": "RAG_POLICY",
      "description": "Basic shipping policy inquiry",
      "user_message": "¿Cómo funcionan sus envíos y cuál es el costo?",
      "context": {
        "customer_id": "sim-user-001",
        "loyalty": "NEW"
      },
      "expectations": {
        "accepted_intents": ["POLICY_INQUIRY", "GENERAL_ASSISTANCE"],
        "required_tools": ["get_store_policy"],
        "forbidden_tools": ["track_order"],
        "max_latency_ms": 4000
      },
      "validation_hints": [
        "Should mention delivery times or shipping costs",
        "Should use RAG knowledge"
      ]
    },
    {
