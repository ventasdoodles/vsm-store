{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(npm:*)",
      "Bash(npx:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(rm:*)",
      "Edit(supabase/migrations/*)",
      "Write(supabase/migrations/*)",
      "Edit(*schema*)",
      "Write(*schema*)"
    ],
    "defaultMode": "acceptEdits"
  }
}